PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/talk2
# Use a long random value, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
# Tokens are long-lived on purpose; logout revokes them server-side.
JWT_EXPIRES_IN=3650d
# Comma-separated origins allowed by CORS, or * for any origin.
CORS_ORIGIN=*
